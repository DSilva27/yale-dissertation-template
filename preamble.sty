\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[Yale September 10, 2026 dissertation preamble]

% ---- main vs. supplementary numbering ------------------------------
\newcommand{\mainnumbering}{%
  \renewcommand{\thesection} {\thechapter.\arabic{section}}%
  \renewcommand{\thefigure}  {\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}   {\thechapter.\arabic{table}}%
  \renewcommand{\theequation}{\thechapter.\arabic{equation}}%
  \def\theHsection {\thechapter.\arabic{section}}%
  \def\theHfigure  {\thechapter.\arabic{figure}}%
  \def\theHtable   {\thechapter.\arabic{table}}%
  \def\theHequation{\thechapter.\arabic{equation}}%
}

\newcommand{\suppnumbering}{%
  \setcounter{section}{0}%
  \setcounter{figure}{0}%
  \setcounter{table}{0}%
  \setcounter{equation}{0}%
  \renewcommand{\thesection} {S\thechapter.\arabic{section}}%
  \renewcommand{\thefigure}  {S\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}   {S\thechapter.\arabic{table}}%
  \renewcommand{\theequation}{S\thechapter.\arabic{equation}}%
  \def\theHsection {\thechapter.S\arabic{section}}%
  \def\theHfigure  {\thechapter.S\arabic{figure}}%
  \def\theHtable   {\thechapter.S\arabic{table}}%
  \def\theHequation{\thechapter.S\arabic{equation}}%
}

% restore main numbering at the start of every chapter
\AddToHook{cmd/chapter/before}{\mainnumbering}

% ---- per-chapter appendix heading ---------------------------------
\newcommand{\chapterappendix}[1][Appendix]{%
  \suppnumbering
  \section*{#1}%
  \addcontentsline{toc}{section}{#1}%
}

\newenvironment{chapterabstract}
  {\begin{center}\bfseries\abstractname\end{center}%
   \begin{quotation}\singlespacing\noindent\ignorespaces}
  {\end{quotation}}
